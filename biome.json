{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/node_modules", "!!**/dist", "!!**/coverage", "!!tmp", "!**/package-lock.json"],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded"
    },
    "jsxRuntime": "reactClassic"
  },
  "json": {
    "formatter": {
      "expand": "auto"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["app.tsx", "src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "error"
          }
        }
      }
    },
    {
      "includes": [
        "app.tsx",
        "src/*.tsx",
        "src/components/**",
        "src/lib/**",
        "src/use*.ts",
        "src/project-colors.ts",
        "src/title-generation-state.ts",
        "src/sidebar-settings.ts",
        "src/working-since.ts",
        "src/working-tree.ts",
        "src/drag-preview.ts",
        "src/settled-port-prompt.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": []
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/*.ts",
        "!src/*.test.ts",
        "!src/*.d.ts",
        "!src/test-*.ts",
        "!src/use*.ts",
        "!src/server.ts",
        "!src/ports-host.ts",
        "!src/port-scan.ts",
