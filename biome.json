        "!src/settled-port-prompt.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["react", "react/**", "node:*", "node:*/**", "react-dom", "react-dom/**"],
                    "message": "Shared modules must stay independent of React and Node."
                  }
